# Copy to .env (or export) to switch the data layer or the broker.
# Default: SQLite file in ./data. For Supabase, paste the Postgres connection string.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# Alpaca paper trading (optional). Leave unset to use the simulated broker.
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=